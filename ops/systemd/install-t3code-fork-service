#!/bin/sh
set -eu

[ "$(id -u)" -eq 0 ] || { printf '%s\n' "Run this installer as root." >&2; exit 1; }

run_user="${T3CODE_RUN_USER:-codex}"
repo="${T3CODE_REPOSITORY_PATH:-/home/codex/work/t3code}"
state_dir="${T3CODE_STATE_DIR:-/home/codex/.t3code/userdata}"
releases_dir="${state_dir}/fork-releases"
current_link="${state_dir}/fork-current"
script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
lock_helper="${script_dir}/t3code-fork-lock"
node_path="/home/codex/.local/share/pnpm/bin/node"
node_dir="/home/codex/.local/share/pnpm/bin"
corepack_path="/usr/bin/corepack"
expected_pnpm_version="11.10.0"
dropin_dir="/etc/systemd/system/t3code.service.d"
dropin_path="${dropin_dir}/zz-fork-update.conf"
old_dropin_path="${dropin_dir}/fork-update.conf"
health_script="/usr/local/sbin/t3code-fork-healthcheck"
health_lock_helper="/usr/local/sbin/t3code-fork-lock"
health_service="/etc/systemd/system/t3code-fork-healthcheck.service"
health_timer="/etc/systemd/system/t3code-fork-healthcheck.timer"
availability_script="/usr/local/sbin/t3code-availability-healthcheck"
availability_service="/etc/systemd/system/t3code-availability-healthcheck.service"
availability_timer="/etc/systemd/system/t3code-availability-healthcheck.timer"
tmpfiles_config="/etc/tmpfiles.d/t3code-watchdog.conf"
watchdog_group="t3code-watchdog"
watchdog_runtime_dir="/run/t3code-watchdog"
installer_lock="${watchdog_runtime_dir}/installer.lock"
authority_lock="${watchdog_runtime_dir}/authority.lock"
nightly_unit_dir="/etc/systemd/system"
nightly_timer_unit="t3code-nightly-update.timer"
nightly_service_unit="t3code-nightly-update.service"
nightly_timer_path="${nightly_unit_dir}/${nightly_timer_unit}"
nightly_service_path="${nightly_unit_dir}/${nightly_service_unit}"
nightly_wants_dir="${nightly_unit_dir}/timers.target.wants"
nightly_wants_link="${nightly_wants_dir}/${nightly_timer_unit}"
health_url="${T3CODE_HEALTH_URL:-http://127.0.0.1:41731/.well-known/t3/environment}"

[ -x "$node_path" ] || { printf '%s\n' "Configured Node executable is unavailable." >&2; exit 1; }
[ -x "$corepack_path" ] || { printf '%s\n' "Fixed Corepack executable is unavailable." >&2; exit 1; }
[ -x "$lock_helper" ] || { printf '%s\n' "Update lock helper is unavailable." >&2; exit 1; }
command -v flock >/dev/null 2>&1 || { printf '%s\n' "flock is unavailable." >&2; exit 1; }

# Establish the process-local and shared authority locks before the legacy
# fork-update guard. Runtime entries are root-owned and cannot be replaced by
# the application group.
/usr/sbin/groupadd --system --force "$watchdog_group"
if [ -e "$watchdog_runtime_dir" ] || [ -L "$watchdog_runtime_dir" ]; then
  [ -d "$watchdog_runtime_dir" ] && [ ! -L "$watchdog_runtime_dir" ] || {
    printf '%s\n' "Watchdog runtime is unsafe." >&2
    exit 1
  }
  [ "$(stat -c '%U:%G:%a' "$watchdog_runtime_dir")" = "root:${watchdog_group}:750" ] || {
    printf '%s\n' "Watchdog runtime ownership is unsafe." >&2
    exit 1
  }
else
  install -d -m 0750 -o root -g "$watchdog_group" "$watchdog_runtime_dir"
fi
if [ ! -e "$installer_lock" ] && [ ! -L "$installer_lock" ]; then
  (umask 077; set -C; : >"$installer_lock") 2>/dev/null || true
fi
if [ ! -e "$authority_lock" ] && [ ! -L "$authority_lock" ]; then
  (umask 0117; set -C; : >"$authority_lock") 2>/dev/null || true
  chown root:"$watchdog_group" "$authority_lock"
fi
[ -f "$installer_lock" ] && [ ! -L "$installer_lock" ] || exit 1
[ -f "$authority_lock" ] && [ ! -L "$authority_lock" ] || exit 1
[ "$(stat -c '%u:%a:%h' "$installer_lock")" = "0:600:1" ] || exit 1
[ "$(stat -c '%u:%a:%h' "$authority_lock")" = "0:660:1" ] || exit 1
exec 8<>"$installer_lock"
flock -n 8 || { printf '%s\n' "Another watchdog installer is active." >&2; exit 1; }
exec 9<>"$authority_lock"
flock -x 9

passwd_entry="$(/usr/bin/getent passwd "$run_user")"
[ -n "$passwd_entry" ] || { printf '%s\n' "Configured run user does not exist." >&2; exit 1; }
[ "$(printf '%s\n' "$passwd_entry" | /usr/bin/wc -l)" -eq 1 ] ||
  { printf '%s\n' "Configured run user lookup was ambiguous." >&2; exit 1; }
[ "$(printf '%s\n' "$passwd_entry" | /usr/bin/cut -d: -f1)" = "$run_user" ] ||
  { printf '%s\n' "Configured run user lookup did not match." >&2; exit 1; }
run_home="$(printf '%s\n' "$passwd_entry" | /usr/bin/cut -d: -f6)"
case "$run_home" in /*) ;; *) printf '%s\n' "Configured run user home is invalid." >&2; exit 1 ;; esac
[ -d "$run_home" ] && [ ! -L "$run_home" ] ||
  { printf '%s\n' "Configured run user home is unavailable." >&2; exit 1; }
[ "$(/usr/bin/stat -c '%U' "$run_home")" = "$run_user" ] ||
  { printf '%s\n' "Configured run user does not own its home." >&2; exit 1; }
corepack_home="${run_home}/.cache/node/corepack"
[ -d "$corepack_home" ] && [ ! -L "$corepack_home" ] ||
  { printf '%s\n' "Pinned Corepack cache is unavailable." >&2; exit 1; }
[ "$(/usr/bin/stat -c '%U' "$corepack_home")" = "$run_user" ] ||
  { printf '%s\n' "Configured run user does not own its Corepack cache." >&2; exit 1; }
cached_pnpm_dir="${corepack_home}/v1/pnpm/${expected_pnpm_version}"
[ -d "$cached_pnpm_dir" ] && [ ! -L "$cached_pnpm_dir" ] ||
  { printf '%s\n' "Pinned pnpm is not cached for offline use." >&2; exit 1; }
[ "$(/usr/bin/stat -c '%U' "$cached_pnpm_dir")" = "$run_user" ] ||
  { printf '%s\n' "Configured run user does not own cached pnpm." >&2; exit 1; }

run_as_user() {
  /usr/sbin/runuser -u "$run_user" -- /usr/bin/env \
    "HOME=$run_home" \
    "COREPACK_HOME=$corepack_home" \
    "COREPACK_ENABLE_NETWORK=0" \
    "COREPACK_ENABLE_PROJECT_SPEC=0" \
    "COREPACK_ENV_FILE=0" \
    "PATH=$node_dir:/usr/bin:/bin" \
    "$@"
}
run_pnpm() {
  run_as_user "$corepack_path" "pnpm@${expected_pnpm_version}" "$@"
}
lock_acquired=false
release_update_lock() {
  [ "$lock_acquired" = true ] || return
  if "$lock_helper" release "$state_dir" "$$" "$lock_token"; then
    lock_acquired=false
  else
    return 1
  fi
}
early_exit_handler() {
  status=$?
  trap - EXIT
  release_update_lock || true
  exit "$status"
}
early_signal_handler() {
  trap - EXIT HUP INT TERM
  release_update_lock || true
  exit 1
}
trap early_exit_handler EXIT
trap early_signal_handler HUP INT TERM

pnpm_version="$(run_pnpm --version)"
[ "$pnpm_version" = "$expected_pnpm_version" ] ||
  { printf '%s\n' "Pinned pnpm version check failed." >&2; exit 1; }

install -d -o "$run_user" -g "$run_user" "$state_dir"
lock_token="$(/usr/bin/cat /proc/sys/kernel/random/uuid)"
"$lock_helper" acquire "$state_dir" "$$" "$lock_token"
lock_acquired=true

remote_matches() {
  case "$1" in
    "https://github.com/$2"|"https://github.com/$2.git"|"git@github.com:$2"|"git@github.com:$2.git"|"ssh://git@github.com/$2"|"ssh://git@github.com/$2.git") return 0 ;;
    *) return 1 ;;
  esac
}

[ "$(run_as_user git -C "$repo" status --porcelain)" = "" ] || { printf '%s\n' "Dirty checkout." >&2; exit 1; }
[ "$(run_as_user git -C "$repo" branch --show-current)" = main ] || { printf '%s\n' "Checkout must be on main." >&2; exit 1; }
origin_url="$(run_as_user git -C "$repo" remote get-url origin)"
upstream_url="$(run_as_user git -C "$repo" remote get-url upstream)"
remote_matches "$origin_url" "MaximilianMauroner/t3code" || { printf '%s\n' "Unexpected origin." >&2; exit 1; }
remote_matches "$upstream_url" "pingdotgg/t3code" || { printf '%s\n' "Unexpected upstream." >&2; exit 1; }
run_as_user git -C "$repo" fetch --prune origin refs/heads/main:refs/remotes/origin/main
commit="$(run_as_user git -C "$repo" rev-parse HEAD)"
origin_commit="$(run_as_user git -C "$repo" rev-parse origin/main)"
[ "$commit" = "$origin_commit" ] || { printf '%s\n' "HEAD does not equal fetched origin/main." >&2; exit 1; }

release_dir="${releases_dir}/${commit}"
entry="${release_dir}/node_modules/t3/dist/bin.mjs"
sentinel="${release_dir}/.t3-fork-release-complete"
install -d -o "$run_user" -g "$run_user" "$releases_dir"
if [ ! -f "$sentinel" ] || [ "$(cat "$sentinel")" != "$commit" ] || [ ! -f "$entry" ]; then
  staged_release="${releases_dir}/.release-${commit}"
  staged_package="${staged_release}/node_modules/t3"
  rm -rf "$staged_release" "${releases_dir}/.pack-${commit}"
  install -d -o "$run_user" -g "$run_user" "$staged_release"
  run_pnpm -C "$repo" install --frozen-lockfile
  run_pnpm -C "$repo" exec vp test run packages/contracts/src/server.test.ts \
    apps/server/src/cloud/forkUpdate.test.ts apps/server/src/cloud/forkHealthcheck.test.ts \
    apps/server/src/cloud/forkInstaller.test.ts \
    apps/server/src/orchestration/UpdateMaintenanceGate.test.ts \
    apps/server/src/orchestration/Layers/OrchestrationEngine.test.ts \
    apps/web/src/components/ForkUpdateAction.test.tsx \
    apps/web/src/components/settings/ConnectionsSettings.logic.test.ts
  run_pnpm -C "$repo" exec vp run --filter @t3tools/contracts --filter @t3tools/web --filter t3 typecheck
  run_pnpm -C "$repo" exec vp run --filter @t3tools/web build
  run_pnpm -C "$repo" exec vp run --filter t3 build
  run_pnpm -C "$repo" --filter t3 deploy --prod --legacy --offline "$staged_package"
  run_as_user "$node_path" "$staged_package/dist/bin.mjs" --version >/dev/null
  run_as_user sh -c 'printf "%s\n" "$1" >"$2"' bootstrap "$commit" "$staged_release/.t3-fork-release-complete"
  rm -rf "$release_dir"
  mv "$staged_release" "$release_dir"
  rm -rf "${releases_dir}/.pack-${commit}"
fi
"$node_path" "$entry" --version >/dev/null

health_body_matches_commit() {
  printf '%s' "$1" | grep -Eq "\"currentCommit\"[[:space:]]*:[[:space:]]*\"${commit}\""
}
wait_for_release_ready() {
  readiness_deadline=$(( $(date +%s) + 60 ))
  while :; do
    if body="$(curl --fail --silent --show-error --max-time 2 "$health_url")"; then
      if health_body_matches_commit "$body"; then return 0; fi
      printf '%s\n' "T3 Code became reachable with an unexpected commit." >&2
      return 1
    fi
    readiness_now="$(date +%s)"
    if [ "$readiness_now" -ge "$readiness_deadline" ]; then
      printf '%s\n' "T3 Code did not become reachable within 60 seconds." >&2
      return 1
    fi
    sleep 1
  done
}
watch_release_health() {
  verified_seconds=0
  while [ "$verified_seconds" -lt 120 ]; do
    sleep 5
    body="$(curl --fail --silent --show-error --max-time 2 "$health_url")" || {
      printf '%s\n' "T3 Code became unreachable during release verification." >&2
      return 1
    }
    health_body_matches_commit "$body" || {
      printf '%s\n' "T3 Code reported an unexpected commit during release verification." >&2
      return 1
    }
    verified_seconds=$((verified_seconds + 5))
  done
}
read_unit_state() {
  operation="$1"; unit="$2"
  if unit_state="$(systemctl "$operation" "$unit" 2>/dev/null)"; then :; else :; fi
  [ -n "$unit_state" ] || return 1
  printf '%s\n' "$unit_state"
}
validate_nightly_source_path() {
  source="$1"
  if [ -L "$source" ]; then
    [ "$(/usr/bin/readlink "$source")" = /dev/null ] || return 1
  else
    [ -f "$source" ] || return 1
    [ "$(/usr/bin/stat -c '%u' "$source")" -eq 0 ] || return 1
    [ "$(/usr/bin/stat -c '%a' "$source")" = 644 ] || return 1
  fi
}
validate_nightly_wants_link() {
  if [ "$nightly_timer_enabled" = enabled ]; then
    [ -L "$nightly_wants_link" ] || return 1
    [ "$(/usr/bin/readlink "$nightly_wants_link")" = "$nightly_timer_path" ] || return 1
  else
    [ ! -e "$nightly_wants_link" ] && [ ! -L "$nightly_wants_link" ] || return 1
  fi
}
validate_nightly_preflight() {
  [ -d "$nightly_unit_dir" ] && [ ! -L "$nightly_unit_dir" ] || return 1
  [ -d "$nightly_wants_dir" ] && [ ! -L "$nightly_wants_dir" ] || return 1
  validate_nightly_source_path "$nightly_timer_path" || return 1
  validate_nightly_source_path "$nightly_service_path" || return 1
  nightly_timer_enabled="$(read_unit_state is-enabled "$nightly_timer_unit")" || return 1
  nightly_service_enabled="$(read_unit_state is-enabled "$nightly_service_unit")" || return 1
  nightly_timer_active="$(read_unit_state is-active "$nightly_timer_unit")" || return 1
  nightly_service_active="$(read_unit_state is-active "$nightly_service_unit")" || return 1
  case "$nightly_timer_enabled" in enabled|disabled|masked) ;; *) return 1 ;; esac
  case "$nightly_service_enabled" in static|masked) ;; *) return 1 ;; esac
  case "$nightly_timer_active" in active|inactive) ;; *) return 1 ;; esac
  case "$nightly_service_active" in active|inactive) ;; *) return 1 ;; esac
  validate_nightly_wants_link
}
validate_nightly_preflight ||
  { printf '%s\n' "Nightly updater unit preflight failed." >&2; exit 1; }

# Everything below is one reversible activation transaction.
backup_dir="$(mktemp -d)"
chmod 0700 "$backup_dir"
nightly_backup_complete=false
backup_file() {
  label="$1"; source="$2"
  if [ -e "$source" ] || [ -L "$source" ]; then cp -a "$source" "$backup_dir/$label"; else : >"$backup_dir/$label.absent"; fi
}
restore_file() {
  label="$1"; target="$2"
  rm -rf "$target"
  [ -f "$backup_dir/$label.absent" ] || cp -a "$backup_dir/$label" "$target"
}
backup_nightly_path() {
  label="$1"; source="$2"
  if [ -e "$source" ] || [ -L "$source" ]; then
    [ ! -d "$source" ] || [ -L "$source" ] || return 1
    cp -a "$source" "$backup_dir/$label"
  else
    : >"$backup_dir/$label.absent"
  fi
}
restore_nightly_path() {
  label="$1"; target="$2"
  [ ! -d "$target" ] || [ -L "$target" ] || return 1
  rm -f "$target"
  [ -f "$backup_dir/$label.absent" ] || cp -a "$backup_dir/$label" "$target"
}
backup_file current "$current_link"
backup_file old_dropin "$old_dropin_path"
backup_file dropin "$dropin_path"
backup_file health_script "$health_script"
backup_file health_lock_helper "$health_lock_helper"
backup_file health_service "$health_service"
backup_file health_timer "$health_timer"
backup_file availability_script "$availability_script"
backup_file availability_service "$availability_service"
backup_file availability_timer "$availability_timer"
backup_file tmpfiles_config "$tmpfiles_config"
validate_nightly_source_path "$nightly_timer_path"
validate_nightly_source_path "$nightly_service_path"
validate_nightly_wants_link
backup_nightly_path nightly_timer "$nightly_timer_path"
backup_nightly_path nightly_service "$nightly_service_path"
backup_nightly_path nightly_wants "$nightly_wants_link"
nightly_backup_complete=true
health_enabled="$(systemctl is-enabled t3code-fork-healthcheck.timer 2>/dev/null || true)"
health_active="$(systemctl is-active t3code-fork-healthcheck.timer 2>/dev/null || true)"
health_service_enabled="$(systemctl is-enabled t3code-fork-healthcheck.service 2>/dev/null || true)"
health_service_active="$(systemctl is-active t3code-fork-healthcheck.service 2>/dev/null || true)"
health_service_failed="$(systemctl is-failed t3code-fork-healthcheck.service 2>/dev/null || true)"
availability_enabled="$(systemctl is-enabled t3code-availability-healthcheck.timer 2>/dev/null || true)"
availability_active="$(systemctl is-active t3code-availability-healthcheck.timer 2>/dev/null || true)"
availability_service_enabled="$(systemctl is-enabled t3code-availability-healthcheck.service 2>/dev/null || true)"
availability_service_active="$(systemctl is-active t3code-availability-healthcheck.service 2>/dev/null || true)"
availability_service_failed="$(systemctl is-failed t3code-availability-healthcheck.service 2>/dev/null || true)"
service_active="$(systemctl is-active t3code.service 2>/dev/null || true)"
install_complete=false
rollback_complete=false
verify_nightly_original_state() {
  validate_nightly_source_path "$nightly_timer_path" || return 1
  validate_nightly_source_path "$nightly_service_path" || return 1
  [ "$(read_unit_state is-enabled "$nightly_timer_unit")" = "$nightly_timer_enabled" ] || return 1
  [ "$(read_unit_state is-enabled "$nightly_service_unit")" = "$nightly_service_enabled" ] || return 1
  [ "$(read_unit_state is-active "$nightly_timer_unit")" = "$nightly_timer_active" ] || return 1
  [ "$(read_unit_state is-active "$nightly_service_unit")" = "$nightly_service_active" ] || return 1
  validate_nightly_wants_link
}
restore_nightly_units() {
  systemctl stop "$nightly_timer_unit" || return 1
  systemctl stop "$nightly_service_unit" || return 1
  systemctl unmask "$nightly_timer_unit" || return 1
  systemctl unmask "$nightly_service_unit" || return 1
  restore_nightly_path nightly_timer "$nightly_timer_path" || return 1
  restore_nightly_path nightly_service "$nightly_service_path" || return 1
  restore_nightly_path nightly_wants "$nightly_wants_link" || return 1
  systemctl daemon-reload || return 1
  case "$nightly_timer_enabled" in
    enabled) systemctl enable "$nightly_timer_unit" || return 1 ;;
    disabled) systemctl disable "$nightly_timer_unit" || return 1 ;;
    masked) : ;;
  esac
  case "$nightly_timer_active" in
    active) systemctl start "$nightly_timer_unit" || return 1 ;;
    inactive) systemctl stop "$nightly_timer_unit" || return 1 ;;
  esac
  case "$nightly_service_active" in
    active) systemctl start "$nightly_service_unit" || return 1 ;;
    inactive) systemctl stop "$nightly_service_unit" || return 1 ;;
  esac
  verify_nightly_original_state
}
restore_checker_service_state() {
  unit="$1"; enabled="$2"; active="$3"; failed="$4"
  case "$enabled" in
    enabled) systemctl unmask "$unit" || return 1; systemctl enable "$unit" || return 1 ;;
    masked) systemctl mask "$unit" || return 1 ;;
    static|disabled) systemctl unmask "$unit" || return 1 ;;
    not-found|"") : ;;
    *) return 1 ;;
  esac
  case "$active" in
    active) systemctl start "$unit" || return 1 ;;
    inactive|failed|not-found|"") systemctl stop "$unit" >/dev/null 2>&1 || true ;;
    *) return 1 ;;
  esac
  if [ "$failed" = failed ]; then
    [ "$(systemctl is-failed "$unit" 2>/dev/null || true)" = failed ] || {
      systemctl start "$unit" >/dev/null 2>&1 || true
      [ "$(systemctl is-failed "$unit" 2>/dev/null || true)" = failed ] || return 1
    }
  else
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
  fi
  [ "$(systemctl is-enabled "$unit" 2>/dev/null || true)" = "$enabled" ] || return 1
  [ "$(systemctl is-active "$unit" 2>/dev/null || true)" = "$active" ] || return 1
}
rollback() {
  [ "$rollback_complete" = true ] && return
  rollback_complete=true
  if [ "$install_complete" = true ]; then
    rm -rf "$backup_dir"
    release_update_lock || true
    return
  fi
  rollback_failed=false
  nightly_restore_failed=false
  if [ "$nightly_backup_complete" = true ] && ! restore_nightly_units; then
    nightly_restore_failed=true
    rollback_failed=true
  fi
  restore_file current "$current_link"
  restore_file old_dropin "$old_dropin_path"
  restore_file dropin "$dropin_path"
  restore_file health_script "$health_script"
  restore_file health_lock_helper "$health_lock_helper"
  restore_file health_service "$health_service"
  restore_file health_timer "$health_timer"
  restore_file availability_script "$availability_script"
  restore_file availability_service "$availability_service"
  restore_file availability_timer "$availability_timer"
  restore_file tmpfiles_config "$tmpfiles_config"
  systemctl daemon-reload || true
  systemctl reset-failed t3code-fork-healthcheck.timer t3code-fork-healthcheck.service t3code-availability-healthcheck.timer t3code-availability-healthcheck.service || true
  systemctl unmask t3code-fork-healthcheck.timer >/dev/null 2>&1 || true
  case "$health_enabled" in enabled) systemctl enable t3code-fork-healthcheck.timer || true ;; masked) systemctl mask t3code-fork-healthcheck.timer || true ;; *) systemctl disable t3code-fork-healthcheck.timer || true ;; esac
  [ "$health_active" = active ] && systemctl start t3code-fork-healthcheck.timer || systemctl stop t3code-fork-healthcheck.timer || true
  case "$availability_enabled" in enabled) systemctl enable t3code-availability-healthcheck.timer || true ;; masked) systemctl mask t3code-availability-healthcheck.timer || true ;; *) systemctl disable t3code-availability-healthcheck.timer || true ;; esac
  [ "$availability_active" = active ] && systemctl start t3code-availability-healthcheck.timer || systemctl stop t3code-availability-healthcheck.timer || true
  [ "$health_service_active" = active ] && systemctl start t3code-fork-healthcheck.service || systemctl stop t3code-fork-healthcheck.service || true
  [ "$availability_service_active" = active ] && systemctl start t3code-availability-healthcheck.service || systemctl stop t3code-availability-healthcheck.service || true
  if ! restore_checker_service_state t3code-fork-healthcheck.service "$health_service_enabled" "$health_service_active" "$health_service_failed"; then rollback_failed=true; fi
  if ! restore_checker_service_state t3code-availability-healthcheck.service "$availability_service_enabled" "$availability_service_active" "$availability_service_failed"; then rollback_failed=true; fi
  [ "$service_active" = active ] && systemctl restart t3code.service || systemctl stop t3code.service || true
  if [ "$nightly_restore_failed" = true ] || [ "$rollback_failed" = true ]; then
    printf '%s\n' "Watchdog rollback backup preserved at ${backup_dir} for recovery." >&2
  else
    rm -rf "$backup_dir"
  fi
  if ! release_update_lock; then rollback_failed=true; fi
  [ "$rollback_failed" = false ] || return 1
}
exit_handler() {
  status=$?
  trap - EXIT
  rollback
  exit "$status"
}
signal_handler() {
  trap - EXIT HUP INT TERM
  rollback
  exit 1
}
trap exit_handler EXIT
trap signal_handler HUP INT TERM

# Quiesce both timer/service pairs before replacing any executable or unit.
systemctl stop t3code-fork-healthcheck.timer
systemctl stop t3code-fork-healthcheck.service
systemctl stop t3code-availability-healthcheck.timer 2>/dev/null || true
systemctl stop t3code-availability-healthcheck.service 2>/dev/null || true
[ "$(systemctl is-active t3code-fork-healthcheck.service 2>/dev/null || true)" != active ]
[ "$(systemctl is-active t3code-availability-healthcheck.service 2>/dev/null || true)" != active ]

next_link="${current_link}.bootstrap.$$"
ln -s "$release_dir" "$next_link"
mv -Tf "$next_link" "$current_link"
install -d "$dropin_dir"
rm -f "$old_dropin_path"
/usr/sbin/usermod -a -G "$watchdog_group" "$run_user"
install -m 0644 "$script_dir/t3code.service.d/zz-fork-update.conf" "$dropin_path"
install -m 0755 "$script_dir/t3code-fork-healthcheck" "$health_script"
install -m 0755 "$lock_helper" "$health_lock_helper"
install -m 0644 "$script_dir/t3code-fork-healthcheck.service" "$health_service"
install -m 0644 "$script_dir/t3code-fork-healthcheck.timer" "$health_timer"
install -m 0755 "$script_dir/t3code-availability-healthcheck" "$availability_script"
install -m 0644 "$script_dir/t3code-availability-healthcheck.service" "$availability_service"
install -m 0644 "$script_dir/t3code-availability-healthcheck.timer" "$availability_timer"
install -m 0644 "$script_dir/t3code-watchdog.tmpfiles" "$tmpfiles_config"
/usr/bin/systemd-tmpfiles --create "$tmpfiles_config"
systemctl daemon-reload
systemctl reset-failed t3code-fork-healthcheck.timer t3code-fork-healthcheck.service t3code-availability-healthcheck.timer t3code-availability-healthcheck.service
systemctl disable --now t3code-fork-healthcheck.timer
systemctl stop t3code-fork-healthcheck.service
systemctl disable --now t3code-availability-healthcheck.timer
systemctl stop t3code-availability-healthcheck.service
systemctl show t3code.service -p ExecStart --value | grep -F "fork-current/node_modules/t3/dist/bin.mjs" >/dev/null
systemctl stop "$nightly_timer_unit"
systemctl stop "$nightly_service_unit"
case "$nightly_timer_enabled" in
  enabled|disabled) systemctl disable "$nightly_timer_unit" ;;
  masked) : ;;
esac
[ ! -e "$nightly_wants_link" ] && [ ! -L "$nightly_wants_link" ]
validate_nightly_source_path "$nightly_timer_path"
validate_nightly_source_path "$nightly_service_path"
[ ! -d "$nightly_timer_path" ] || [ -L "$nightly_timer_path" ]
[ ! -d "$nightly_service_path" ] || [ -L "$nightly_service_path" ]
rm -f "$nightly_timer_path"
rm -f "$nightly_service_path"
systemctl daemon-reload
systemctl mask "$nightly_timer_unit"
systemctl mask "$nightly_service_unit"
[ "$(/usr/bin/readlink "$nightly_timer_path")" = /dev/null ]
[ "$(/usr/bin/readlink "$nightly_service_path")" = /dev/null ]
[ "$(read_unit_state is-enabled "$nightly_timer_unit")" = masked ]
[ "$(read_unit_state is-enabled "$nightly_service_unit")" = masked ]
[ "$(read_unit_state is-active "$nightly_timer_unit")" = inactive ]
[ "$(read_unit_state is-active "$nightly_service_unit")" = inactive ]
systemctl restart t3code.service
wait_for_release_ready
watch_release_health
systemctl enable --now t3code-fork-healthcheck.timer
# Availability is deliberately staged disabled for a separate rollout decision.
[ "$(systemctl is-enabled t3code-availability-healthcheck.timer 2>/dev/null || true)" = disabled ]
[ "$(systemctl is-active t3code-availability-healthcheck.timer 2>/dev/null || true)" = inactive ]

# Commit activation before releasing ownership. From here on, failures leave
# the verified deployment in place and never run rollback.
trap - EXIT HUP INT TERM
install_complete=true
rollback_complete=true
rm -rf "$backup_dir"
if ! release_update_lock; then
  printf '%s\n' "Verified activation is committed, but update lock ownership changed; refusing rollback." >&2
  exit 1
fi
printf '%s\n' "Installed and verified immutable T3 Code fork release ${commit}."
